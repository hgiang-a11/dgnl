<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/success"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Hai vòng tròn lan ra liên tục phía sau icon. -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp">

        <View
            android:id="@+id/pulse1"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse" />

        <View
            android:id="@+id/pulse2"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse" />

        <FrameLayout
            android:id="@+id/alarmIcon"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_alarm_icon"
            android:elevation="8dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_stat_pin"
                android:tint="@color/success" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/alarm_title"
        android:textColor="#FFFFFF"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/txtAlarmMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="#E6FFFFFF"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnDismiss"
        style="@style/Btn"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_btn_white"
        android:elevation="4dp"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:text="@string/alarm_dismiss"
        android:textAllCaps="false"
        android:textColor="@color/success_dark"
        android:textSize="20sp" />
</LinearLayout>
