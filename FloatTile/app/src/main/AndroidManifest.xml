<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        <queries>: từ Android 11, ứng dụng chỉ "nhìn thấy" ứng dụng khác nếu khai báo ở đây
        (cơ chế package visibility = giới hạn quyền xem danh sách ứng dụng).
        - Mục intent MAIN/LAUNCHER: cho phép liệt kê mọi ứng dụng có biểu tượng ngoài màn hình chính.
        - Mục package: cho phép kiểm tra trực tiếp ứng dụng Claude và Shizuku.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.anthropic.claude" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".FloatTileApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FloatTile">

        <!-- Màn hình cài đặt chính. Nhấn giữ ô trong bảng cài đặt nhanh cũng mở màn hình này. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TileEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="@string/title_pick_app" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/title_diagnostics" />

        <activity
            android:name=".ShizukuGuideActivity"
            android:exported="false"
            android:label="@string/title_shizuku" />

        <!--
            Màn hình "trung chuyển" (trampoline = màn hình trong suốt chỉ dùng để mở màn hình khác).
            Ô cài đặt nhanh mở màn hình này, rồi màn hình này mở ứng dụng đích dạng cửa sổ nổi.
            taskAffinity="" : chạy trong một "task" (ngăn xếp màn hình) riêng, không lẫn với màn hình cài đặt.
        -->
        <activity
            android:name=".LaunchActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.FloatTile.Transparent" />

        <!--
            Cửa sổ thử nghiệm: dùng để kiểm tra máy có thật sự mở được cửa sổ tự do không.
            exported="true" vì cách (b) dùng lệnh shell "am start" (chạy dưới quyền ADB) để mở nó.
            Màn hình này chỉ hiện chữ rồi tự đóng, không chứa dữ liệu gì.
        -->
        <activity
            android:name=".ProbeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:resizeableActivity="true"
            android:taskAffinity="com.floattile.probe"
            android:theme="@style/Theme.FloatTile.Probe" />

        <!--
            Dịch vụ ô cài đặt nhanh (TileService): khai báo sẵn 10 "chỗ".
            Quyền BIND_QUICK_SETTINGS_TILE đảm bảo chỉ giao diện hệ thống mới gắn được vào dịch vụ này.
            Chỗ số 1 bật sẵn (giữ ô "Claude nổi" của bản cũ); các chỗ khác tắt sẵn và
            chỉ được bật khi bạn tạo ô tương ứng trong FloatTile.
        -->
        <service
            android:name=".FloatTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_slot_1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".FloatTileService2"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_slot_2"
