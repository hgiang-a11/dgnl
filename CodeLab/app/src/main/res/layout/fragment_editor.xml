<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/editor_bg">

    <!-- ===== Thanh trên cùng: nút quay lại + tên project ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/editor_topbar"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            android:contentDescription="Quay lại" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Project"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Ngôn ngữ"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== Phần trên: khung CODE ===== -->
    <com.codelab.app.editor.CodeEditText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:gravity="top|start"
        android:scrollbars="vertical"
        android:importantForAutofill="no"
        android:textColor="@color/editor_text" />

    <!-- ===== Thanh nút ở giữa ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/editor_toolbar"
        android:weightSum="6"
        android:paddingVertical="4dp">

        <!-- Nút Chạy -->
        <LinearLayout android:id="@+id/btn_run"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:paddingVertical="6dp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_run" app:tint="#4CAF50"
                android:contentDescription="Chạy" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Chạy" android:textColor="@color/white" android:textSize="10sp" />
        </LinearLayout>

        <!-- Nút Build + Chạy -->
        <LinearLayout android:id="@+id/btn_build_run"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:paddingVertical="6dp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_build_run" app:tint="#64B5F6"
                android:contentDescription="Build và chạy" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Build+Chạy" android:textColor="@color/white" android:textSize="10sp" />
        </LinearLayout>

        <!-- Nút Build (xem lỗi) -->
        <LinearLayout android:id="@+id/btn_build"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:paddingVertical="6dp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_build" app:tint="#FFB74D"
                android:contentDescription="Build xem lỗi" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Build" android:textColor="@color/white" android:textSize="10sp" />
        </LinearLayout>

        <!-- Nút Hoàn tác -->
        <LinearLayout android:id="@+id/btn_undo"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:paddingVertical="6dp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_undo" app:tint="@color/white"
                android:contentDescription="Hoàn tác" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Hoàn tác" android:textColor="@color/white" android:textSize="10sp" />
        </LinearLayout>

        <!-- Nút Làm lại -->
        <LinearLayout android:id="@+id/btn_redo"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:paddingVertical="6dp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_redo" app:tint="@color/white"
                android:contentDescription="Làm lại" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Làm lại" android:textColor="@color/white" android:textSize="10sp" />
        </LinearLayout>

        <!-- Nút Lưu -->
        <LinearLayout android:id="@+id/btn_save"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:paddingVertical="6dp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_save" app:tint="#4DD0E1"
                android:contentDescription="Lưu" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Lưu" android:textColor="@color/white" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Nhãn KẾT QUẢ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/editor_output_bg"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="KẾT QUẢ"
        android:textColor="#808080"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- ===== Phần dưới: khung KẾT QUẢ ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="@color/editor_output_bg"
        android:padding="14dp">

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textColor="@color/editor_text"
            android:textSize="14sp" />
    </ScrollView>

</LinearLayout>
